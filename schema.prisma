generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
//  Enums
// ─────────────────────────────────────────────

enum Role {
  PATIENT
  CLINICIAN
  ADMIN
}

enum AssignmentStatus {
  ACTIVE
  INACTIVE
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum TrendStatus {
  IMPROVING
  STABLE
  WORSENING
}

enum AlertPriority {
  LOW
  MEDIUM
  HIGH
}

enum AlertStatus {
  NEW
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  ESCALATED
  SNOOZED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum Severity {
  MILD
  MODERATE
  SEVERE
  CRITICAL
}

enum Frequency {
  FIRST_TIME
  RECURRING
  CHRONIC
}

enum CareContext {
  ASTHMA_FOLLOWUP
  POST_SURGERY_RECOVERY
  CHRONIC_DISEASE_MONITORING
  INFECTION_FOLLOWUP
  CARDIAC_FOLLOWUP
  DIABETES_MANAGEMENT
  HYPERTENSION_MONITORING
  MATERNAL_CARE
  MENTAL_HEALTH_FOLLOWUP
  PEDIATRIC_FOLLOWUP
  ONCOLOGY_FOLLOWUP
  RENAL_FOLLOWUP
  GENERAL_REVIEW
}

// ─────────────────────────────────────────────
//  Core Identity
// ─────────────────────────────────────────────

model User {
  id        Int      @id @default(autoincrement())
  fullName  String?
  email     String   @unique
  password  String
  phone     String?
  role      Role     @default(PATIENT)
  createdAt DateTime @default(now())

  patient   Patient?
  clinician Clinician?
  pushSubscriptions PushSubscription[]
  auditLogs AuditLog[]
  alertActions Alert[] @relation("AlertLastActor")
  notifications Notification[]
}

// ─────────────────────────────────────────────
//  Patient
// ─────────────────────────────────────────────

model Patient {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique
  emergencyContact String
  address          String?
  dateOfBirth      DateTime
  gender           String
  updatedAt        DateTime  @updatedAt

  // Clinical context — drives the intelligence layer
  chronicConditions String?  // JSON array: ["asthma", "diabetes"]
  allergies         String?  // JSON array: ["penicillin", "latex"]
  baselineStatus    String?  // "stable" | "fragile" |" "unknown

  // Intelligence Layer — updated on each new symptom report
  currentRiskLevel   RiskLevel   @default(LOW)
  currentTrendStatus TrendStatus @default(STABLE)
  lastRiskUpdate     DateTime?
  lastTrendUpdate    DateTime?
  lastReportTime     DateTime?   // Denormalized for fast dashboard sorting

  user           User            @relation(fields: [userId], references: [id])
  assignments    Assignment[]
  symptomReports SymptomReport[]
  alerts         Alert[]
  tasks          Task[]
  followUpResponses    FollowUpResponse[]
  followUpAppointments FollowUpAppointment[]
}

// ─────────────────────────────────────────────
//  Clinician
// ─────────────────────────────────────────────

model Clinician {
  id             Int    @id @default(autoincrement())
  userId         Int    @unique
  fullName       String // Fixed: was `fullname`
  specialization String

  user             User         @relation(fields: [userId], references: [id])
  assignments      Assignment[]
  alertAssignments Alert[]      @relation("AlertAssignee")
  tasks            Task[]
  followUpResponses    FollowUpResponse[]
  followUpAppointments FollowUpAppointment[]
}

// ─────────────────────────────────────────────
//  Assignment — carries care context
// ─────────────────────────────────────────────

model Assignment {
  id          Int              @id @default(autoincrement())
  clinicianId Int
  patientId   Int
  assignedAt  DateTime         @default(now())
  status      AssignmentStatus @default(ACTIVE)
  endedAt     DateTime?        // Set when status transitions to INACTIVE

  // Care context — the reason this clinician monitors this patient
  careContext CareContext @default(GENERAL_REVIEW)
  reason      String?    // Free-text e.g. "Post-discharge hypertension monitoring"

  patient   Patient   @relation(fields: [patientId], references: [id])
  clinician Clinician @relation(fields: [clinicianId], references: [id])

  @@index([patientId, clinicianId])
}

// ─────────────────────────────────────────────
//  Symptom Report — structured clinical inputs
// ─────────────────────────────────────────────

model SymptomReport {
  id        Int      @id @default(autoincrement())
  patientId Int
  notes     String?  // Optional free-text context — NOT used for scoring
  createdAt DateTime @default(now())

  // ── Structured inputs (primary data for intelligence layer) ──
  symptoms           String    @default("[]") // JSON array of symptom IDs
  severity           Severity  @default(MILD)
  durationDays       Int       @default(1)
  frequency          Frequency @default(FIRST_TIME)
  temperature        Float?    // °C — optional vital
  heartRate          Int?      // bpm — optional vital
  medicationAdherent Boolean?  // Is patient taking prescribed meds?

  // ── Intelligence Layer outputs ──
  riskLevel       RiskLevel @default(LOW)
  riskScore       Float     @default(0.0)
  riskFactors     String?   // JSON blob of scoring components
  riskExplanation String?   // Human-readable: "Severe | chest pain | 7 days | asthma context"

  patient Patient  @relation(fields: [patientId], references: [id])
  alerts  Alert[]
  followUpResponses FollowUpResponse[]
}

// ─────────────────────────────────────────────
//  Alert
// ─────────────────────────────────────────────

model Alert {
  id                    Int           @id @default(autoincrement())
  patientId             Int
  symptomReportId       Int
  priority              AlertPriority
  alertType             String        // "HIGH_RISK" | "WORSENING_TREND"
  message               String        // Includes riskExplanation when available
  isRead                Boolean       @default(false)
  status                AlertStatus   @default(NEW)
  assignedToClinicianId Int?
  resolutionNote        String?
  resolvedAt            DateTime?
  snoozedUntil          DateTime?
  lastActionAt          DateTime?
  lastActionByUserId    Int?
  createdAt             DateTime      @default(now())

  patient             Patient       @relation(fields: [patientId], references: [id])
  symptomReport       SymptomReport @relation(fields: [symptomReportId], references: [id])
  assignedToClinician Clinician?    @relation("AlertAssignee", fields: [assignedToClinicianId], references: [id])
  lastActionBy        User?         @relation("AlertLastActor", fields: [lastActionByUserId], references: [id])
  tasks               Task[]

  @@index([status])
  @@index([assignedToClinicianId])
}

model Task {
  id                  Int          @id @default(autoincrement())
  patientId           Int
  assignedClinicianId Int
  createdFromAlertId  Int?
  title               String
  description         String?
  dueAt               DateTime?
  status              TaskStatus   @default(OPEN)
  priority            TaskPriority @default(MEDIUM)
  completedAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  patient            Patient   @relation(fields: [patientId], references: [id])
  assignedClinician  Clinician @relation(fields: [assignedClinicianId], references: [id])
  createdFromAlert   Alert?    @relation(fields: [createdFromAlertId], references: [id])

  @@index([patientId])
  @@index([assignedClinicianId])
  @@index([status])
  @@index([dueAt])
}

// ─────────────────────────────────────────────
//  Push Subscription (Web Push)
// ─────────────────────────────────────────────

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────
//  Audit Log
// ─────────────────────────────────────────────

model AuditLog {
  id           Int      @id @default(autoincrement())
  actorUserId  Int?
  actorRole    String?
  action       String
  method       String
  path         String
  resourceType String?
  resourceId   String?
  statusCode   Int
  ipAddress    String?
  userAgent    String?
  metadata     String?
  createdAt    DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
//  Performance Metric
// ─────────────────────────────────────────────

model PerformanceMetric {
  id             Int      @id @default(autoincrement())
  endpoint       String
  method         String
  responseTimeMs Int
  statusCode     Int
  errorType      String?
  errorMessage   String?
  timestamp      DateTime @default(now())
  userId         Int?
}

// ─────────────────────────────────────────────
//  Clinician follow-up response to a symptom report
// ─────────────────────────────────────────────

model FollowUpResponse {
  id              Int      @id @default(autoincrement())
  symptomReportId Int
  clinicianId     Int
  patientId       Int
  message         String
  actionRequired  Boolean  @default(false)
  createdAt       DateTime @default(now())

  symptomReport SymptomReport @relation(fields: [symptomReportId], references: [id])
  clinician     Clinician     @relation(fields: [clinicianId], references: [id])
  patient       Patient       @relation(fields: [patientId], references: [id])

  @@index([symptomReportId])
  @@index([patientId])
  @@index([clinicianId])
}

// ─────────────────────────────────────────────
//  Follow-up appointment scheduled by a clinician
// ─────────────────────────────────────────────

model FollowUpAppointment {
  id          Int      @id @default(autoincrement())
  patientId   Int
  clinicianId Int
  scheduledAt DateTime
  reason      String
  status      String   @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED | MISSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient   Patient   @relation(fields: [patientId], references: [id])
  clinician Clinician @relation(fields: [clinicianId], references: [id])

  @@index([patientId])
  @@index([clinicianId])
  @@index([scheduledAt])
  @@index([status])
}

// ─────────────────────────────────────────────
//  Internal notification / reminder log
// ─────────────────────────────────────────────

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String   // HIGH_RISK_ALERT | WORSENING_TREND | FOLLOW_UP_SCHEDULED |
                    // FOLLOW_UP_RESPONSE | MEDICATION_CHECK_IN | SYSTEM_MESSAGE
  isRead    Boolean  @default(false)
  link      String?  // optional deep-link path (e.g. /clinician/alerts)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}
